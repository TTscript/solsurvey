# ===========================================
# SolSurvey — Copy to .env
# ===========================================

# 1. Public site URL (used for survey & results links in the builder)
NEXT_PUBLIC_APP_URL=https://solsurvey.site

# 2. RPC URL (Helius recommended: https://helius.dev)
#    Devnet for testing (free SOL: https://faucet.solana.com):
NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

#    Mainnet:
# NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# 3. Survey vault keypair (base58) — holds reward SOL for payouts
#    Run: npm run gen-keypair
#    Fund this wallet with SOL for survey rewards
SURVEY_VAULT_KEYPAIR=

# 4. Wallet verification thresholds (optional)
# Minimum SOL balance (in lamports) to pass verification
MIN_BALANCE_LAMPORTS=100000
# Minimum number of past transactions
MIN_TRANSACTION_COUNT=1
